# Copy to .env locally; never commit real tokens.
# Configure a least-privilege, read-only fine-grained GitHub token only if needed.
UPAOI_GITHUB_TOKEN=
# Notion integration token shared with only the page(s) explicitly permitted.
UPAOI_NOTION_TOKEN=

# Enterprise internal-alpha admission settings (set only in protected runtime config).
# UPAOI_ADMISSION_DB=/var/lib/upaoi/admission.sqlite
# UPAOI_TENANT_REQUESTS_PER_MIN=100
# UPAOI_PRINCIPAL_REQUESTS_PER_MIN=25

# Optional fail-closed external audit checkpoint for the internal alpha.
# Set UPAOI_REQUIRE_EXTERNAL_AUDIT_ANCHOR=1 to reject startup without a path.
# Mount an operator-controlled, read-only, externally retained signed checkpoint.
# The app NEVER creates or overwrites this file. Protect it off-host.
# UPAOI_REQUIRE_EXTERNAL_AUDIT_ANCHOR=1
# UPAOI_EXTERNAL_AUDIT_ANCHOR_FILE=/run/secrets/upaoi-audit-anchor.json
